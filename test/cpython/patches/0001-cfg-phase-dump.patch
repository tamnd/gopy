     return _PyCompile_OptimizeCfg(instructions, consts, nlocals);
 }
 
+/* gopy spec 1716: install a phase-hook on _PyCfg_OptimizeCodeUnit so the
+   port can capture a CFG dump after each optimization pass. The argument
+   must be either None (to clear the hook) or a callable accepting
+   (phase_name: str, dump_text: str). */
+static PyObject *
+_testinternalcapi_set_cfg_phase_hook(PyObject *module, PyObject *callback)
+{
+    if (callback != Py_None && !PyCallable_Check(callback)) {
+        PyErr_SetString(PyExc_TypeError,
+                        "set_cfg_phase_hook() argument must be a callable or None");
+        return NULL;
+    }
+    _PyCfgBuilder_SetPhaseHook(callback);
+    Py_RETURN_NONE;
+}
