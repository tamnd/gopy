+/* Returns a new str. Caller decrefs. */
+static PyObject *
+cfg_dump_to_string(cfg_builder *g)
+{
+    PyUnicodeWriter *w = PyUnicodeWriter_Create(0);
+    if (w == NULL) {
+        return NULL;
+    }
+    for (basicblock *b = g->g_entryblock; b != NULL; b = b->b_next) {
+        if (dump_basicblock(w, b) < 0) {
+            PyUnicodeWriter_Discard(w);
+            return NULL;
         }
     }
+    return PyUnicodeWriter_Finish(w);
+}
+
+static PyObject *cfg_phase_hook = NULL;
+
+void
+_PyCfgBuilder_SetPhaseHook(PyObject *callback)
+{
+    PyObject *new_hook = (callback == Py_None) ? NULL : callback;
+    Py_XINCREF(new_hook);
+    Py_XSETREF(cfg_phase_hook, new_hook);
+}
+
+static int
+cfg_fire_phase(cfg_builder *g, const char *phase_name)
+{
+    if (cfg_phase_hook == NULL) {
+        return SUCCESS;
+    }
+    PyObject *dump = cfg_dump_to_string(g);
+    if (dump == NULL) {
+        return ERROR;
+    }
+    PyObject *res = PyObject_CallFunction(cfg_phase_hook, "sO", phase_name, dump);
+    Py_DECREF(dump);
+    if (res == NULL) {
+        return ERROR;
+    }
+    Py_DECREF(res);
+    return SUCCESS;
 }
 
